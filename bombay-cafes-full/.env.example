# ─────────────────────────────────────────────────────────────────────────────
# Bombay Cafes — environment
#
# Every variable here is OPTIONAL. `npm run dev` with an empty .env.local gives
# you the whole product: the bundled seed dataset, a keyless MapLibre basemap,
# working filters, panels and scoring. Credentials upgrade the app; they do not
# switch it on.
# ─────────────────────────────────────────────────────────────────────────────

# ── Mapbox (optional) ────────────────────────────────────────────────────────
# Public token (pk.…) from https://account.mapbox.com/access-tokens/
# With it:    Mapbox Standard — the closest match to the reference's 3D view.
# Without it: MapLibre GL over OpenFreeMap Positron, no key needed. Still a
#             real tilted 3D map with extruded buildings, not a grey box.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── Supabase (optional) ──────────────────────────────────────────────────────
# Settings → API in your Supabase project. Both are safe in the browser.
# Without them the app reads data/spots.json and feedback POSTs return a clear
# "not configured" error rather than silently dropping.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER prefix this with NEXT_PUBLIC_. It bypasses row-level
# security. Used by `npm run seed`, `npm run geocode`, and the two API routes.
SUPABASE_SERVICE_ROLE_KEY=

# ── Geocoding (optional, and a separate step) ────────────────────────────────
# Only `npm run geocode` reads these. Nothing in the app requires coordinates:
# a spot without them appears everywhere except the map, and the map says so.
# Providers: mapbox | google | opencage | nominatim (nominatim needs no key).
GEOCODING_PROVIDER=
GEOCODING_API_KEY=

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin for metadata, sitemap and OpenGraph URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
